# ============================================================================
# MLCC 量化投研助手 — 环境变量配置模板
# 复制此文件为 .env 并填入你的真实 API 密钥
#   cp .env.example .env
# ============================================================================

# ---- OpenRouter API (必填) ----
# 注册地址：https://openrouter.ai/
# 模型默认使用 Claude Sonnet 4.6，可替换为其他模型
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=anthropic/claude-sonnet-4-6

# ---- Telegram Bot (必填) ----
# 1. 与 @BotFather 对话创建机器人，获取 TOKEN
# 2. 与 @userinfobot 对话获取你的 CHAT_ID
TELEGRAM_BOT_TOKEN=1234567890:AA...your_bot_token
TELEGRAM_CHAT_ID=987654321

# ---- NewsAPI (可选，强烈推荐) ----
# 注册地址：https://newsapi.org/register
# 免费版 100 次请求/天
NEWSAPI_KEY=your-newsapi-key

# ---- Perplexity API (可选) ----
# 注册地址：https://www.perplexity.ai/
# 用于深度行业研究查询
PERPLEXITY_API_KEY=pplx-your-key

# ---- 调试模式 ----
# 设为 1 启用 DEBUG 日志，会输出完整异常堆栈
DEBUG=0
