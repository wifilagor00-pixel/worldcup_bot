# ============================================================================
# MLCC Quant Research — .gitignore
# ============================================================================

# 敏感密钥文件（绝不提交到 GitHub）
.env
*.apps.googleusercontent.com.json
client_secret*.json

# Python 运行时产物
__pycache__/
*.pyc
*.pyo

# 虚拟环境
venv/
.venv/
env/

# IDE
.vscode/
.idea/
.claude/

# 运行时输出（每次运行产生，不入库）
research_data/
logs/
worldcup_bot/tmp/
worldcup_bot/output/
worldcup_bot/bgm.*
!worldcup_bot/bgm.m4a
*.mp4
!worldcup_bot/fallback.mp4
*.mp3

# OS
.DS_Store
Thumbs.db
